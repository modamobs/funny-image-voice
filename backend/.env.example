OPENAI_API_KEY=sk-여기에_OpenAI_API_키_입력
DATABASE_URL=postgresql://user:password@host:5432/dbname
FRONTEND_URL=https://your-app.vercel.app
PORT=3001

# AI 이미지 생성(gpt-image-1) 하루 한도. 0 = 무료 제공 중단(기본값).
# 결제/리워드 광고를 붙인 뒤 다시 열 것. 프론트도 VITE_AI_IMAGE_ENABLED=true 필요.
AI_IMAGE_DAILY_LIMIT=0

# 일일 라운드 스케줄 (기본: 한국 시간 09:00 시작 → 21:00 마감)
ROUND_TZ=Asia/Seoul
ROUND_OPEN_HOUR=9
ROUND_CLOSE_HOUR=21
